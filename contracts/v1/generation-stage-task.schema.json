{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/generation-stage-task.schema.json",
  "title": "ATG generation stage task v1",
  "description": "Trusted-policy-bound generation request. Credentials travel separately. request_digest is the SHA-256 of the exact serialized task bytes, not canonicalized JSON. Repository and prior output text are untrusted data, never commands or approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "run_id", "attempt", "phase", "objective", "profile_digest", "policy_digest", "harness", "model", "source", "prior", "limits"],
  "properties": {
    "schema_version": {"const": "1"},
    "job_id": {"$ref": "common.schema.json#/$defs/id"},
    "run_id": {"$ref": "common.schema.json#/$defs/id"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 100},
    "phase": {"enum": ["analyze", "plan", "code"]},
    "objective": {"type": "string", "minLength": 1, "maxLength": 16384},
    "profile_digest": {"$ref": "common.schema.json#/$defs/payload_digest"},
    "policy_digest": {"$ref": "common.schema.json#/$defs/payload_digest"},
    "harness": {"enum": ["pydantic_ai", "aider"]},
    "model": {"$ref": "#/$defs/model"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_url", "commit", "tree_id", "artifact_ref", "files"],
      "properties": {
        "repository_url": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https://[^/@?#\\s]+(?:/[^?#\\s]*)?$"},
        "commit": {"$ref": "#/$defs/commit"},
        "tree_id": {"$ref": "common.schema.json#/$defs/id"},
        "artifact_ref": {"$ref": "common.schema.json#/$defs/id"},
        "files": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
          "type": "object", "additionalProperties": false, "required": ["path", "digest", "content"],
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "digest": {"$ref": "common.schema.json#/$defs/payload_digest"},
            "content": {"type": "string", "maxLength": 1048576}
          }
        }}
      }
    },
    "prior": {
      "type": "object", "additionalProperties": false,
      "dependentRequired": {"analysis": ["analysis_ref"], "plan": ["plan_ref"]},
      "properties": {
        "analysis_ref": {"$ref": "common.schema.json#/$defs/id"},
        "analysis": {"type": "object", "maxProperties": 128},
        "plan_ref": {"$ref": "common.schema.json#/$defs/id"},
        "plan": {"type": "object", "maxProperties": 128},
        "previous_candidate_ref": {"$ref": "common.schema.json#/$defs/id"},
        "repair_feedback": {"type": "string", "maxLength": 16384}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "max_output_bytes", "max_context_bytes", "max_requests", "max_output_tokens"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_output_bytes": {"type": "integer", "minimum": 4096, "maximum": 1048576},
        "max_context_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 32768}
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^(?:[A-Fa-f0-9]{40}|[A-Fa-f0-9]{64})$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
    "test_path": {"type": "string", "maxLength": 240, "pattern": "^src/test/java/(?:[A-Za-z_][A-Za-z0-9_]*/)*[A-Za-z_][A-Za-z0-9_]*Test\\.java$"},
    "model": {
      "type": "object", "additionalProperties": false, "required": ["provider", "endpoint", "name"],
      "properties": {
        "provider": {"const": "openai_compatible"},
        "endpoint": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^https?://[^/@?#\\s]+(?:/[^?#\\s]*)?$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}
      }
    }
  }
}

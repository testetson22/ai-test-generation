{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/execution-profile.schema.json",
  "title": "ATG approved target execution profile",
  "description": "Trusted, versioned application/toolchain policy. This document is not itself approval; an execution task binds its immutable artifact digest to an approval decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "profile_id", "profile_version", "application", "source_policy", "target", "worker_image", "commands", "test_selection", "limits", "network_policy", "credential_policy"],
  "properties": {
    "contract": { "const": "atg.execution_profile" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "profile_id": { "$ref": "common.schema.json#/$defs/id" },
    "profile_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "application": { "$ref": "common.schema.json#/$defs/identity" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "framework", "framework_version", "runtime", "build_tool"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "framework": { "type": "string", "minLength": 1 },
        "framework_version": { "type": "string", "minLength": 1 },
        "runtime": { "$ref": "common.schema.json#/$defs/identity" },
        "build_tool": { "$ref": "common.schema.json#/$defs/identity" }
      }
    },
    "worker_image": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/identity" },
        { "required": ["digest"] }
      ]
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision_policy"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "revision_policy": { "const": "immutable" },
        "allowed_source_roots": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "phase", "argv", "working_directory", "timeout_seconds"],
        "properties": {
          "command_id": { "$ref": "common.schema.json#/$defs/id" },
          "phase": { "enum": ["prepare", "build", "discover", "test", "collect", "application_start", "application_reset", "cleanup"] },
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "working_directory": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+" },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "environment_names": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }, "uniqueItems": true }
        }
      }
    },
    "test_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "selector", "report_media_type", "minimum_test_count"],
      "properties": {
        "command_id": { "$ref": "common.schema.json#/$defs/id" },
        "selector": { "type": "string", "minLength": 1 },
        "report_media_type": { "type": "string", "minLength": 1 },
        "minimum_test_count": { "type": "integer", "minimum": 1 }
      }
    },
    "application_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_command_id": { "$ref": "common.schema.json#/$defs/id" },
        "health_check_command_id": { "$ref": "common.schema.json#/$defs/id" },
        "reset_command_id": { "$ref": "common.schema.json#/$defs/id" },
        "cleanup_command_id": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_timeout_seconds", "cpu_millis", "memory_bytes", "max_pids", "max_output_bytes", "max_artifact_bytes"],
      "properties": {
        "wall_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "cpu_millis": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "max_pids": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["disabled", "allowlist"] },
        "allowed_hosts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "disabled" } } }, "then": { "properties": { "allowed_hosts": { "maxItems": 0 } } } },
        { "if": { "properties": { "mode": { "const": "allowlist" } } }, "then": { "required": ["allowed_hosts"], "properties": { "allowed_hosts": { "minItems": 1 } } } }
      ]
    },
    "credential_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload_credentials", "acquisition_credential_refs"],
      "properties": {
        "workload_credentials": { "const": "none" },
        "acquisition_credential_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/execution-task-spec.schema.json",
  "title": "ATG immutable approved execution task specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "task_spec_id", "run_id", "expected_run_revision", "pair_id", "generation_id", "subject_role", "comparison_mode", "subject", "generation", "code_approval", "profile", "profile_approval", "expected_test_ids", "retry_policy", "created_at"],
  "properties": {
    "contract": { "const": "atg.execution_task_spec" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "task_spec_id": { "$ref": "common.schema.json#/$defs/id" },
    "run_id": { "$ref": "common.schema.json#/$defs/id" },
    "expected_run_revision": { "type": "integer", "minimum": 1 },
    "pair_id": { "$ref": "common.schema.json#/$defs/id" },
    "generation_id": { "$ref": "common.schema.json#/$defs/id" },
    "subject_role": { "enum": ["base", "candidate"] },
    "comparison_mode": { "enum": ["same_subject_control", "differential"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "identity"],
      "properties": {
        "source": { "$ref": "common.schema.json#/$defs/source" },
        "identity": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/identity" },
            { "required": ["digest"] }
          ]
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "patch", "tests"],
      "properties": {
        "manifest": { "$ref": "common.schema.json#/$defs/artifact" },
        "patch": { "$ref": "common.schema.json#/$defs/artifact" },
        "tests": {
          "allOf": [
            { "$ref": "common.schema.json#/$defs/artifact" },
            { "properties": { "media_type": { "const": "application/vnd.atg.materialized-tests+json" } } }
          ]
        }
      }
    },
    "code_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "decision_id", "reviewer", "reviewed_generation_digest"],
      "properties": {
        "checkpoint_id": { "$ref": "common.schema.json#/$defs/id" },
        "decision_id": { "$ref": "common.schema.json#/$defs/id" },
        "reviewer": { "$ref": "common.schema.json#/$defs/reviewer" },
        "reviewed_generation_digest": { "$ref": "common.schema.json#/$defs/payload_digest" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "artifact"],
      "properties": {
        "profile_id": { "$ref": "common.schema.json#/$defs/id" },
        "profile_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "artifact": { "$ref": "common.schema.json#/$defs/artifact" }
      }
    },
    "profile_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "reviewer", "approved_profile_digest"],
      "properties": {
        "decision_id": { "$ref": "common.schema.json#/$defs/id" },
        "reviewer": { "$ref": "common.schema.json#/$defs/reviewer" },
        "approved_profile_digest": { "$ref": "common.schema.json#/$defs/payload_digest" }
      }
    },
    "expected_test_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "max_attempts", "deadline_at", "initial_backoff_seconds", "max_backoff_seconds", "retryable_failures"],
      "properties": {
        "policy_id": { "$ref": "common.schema.json#/$defs/id" },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "deadline_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "initial_backoff_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "max_backoff_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "retryable_failures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["provider_unavailable", "worker_lost", "worker_resource_exhausted", "artifact_transport_failed"] }
        }
      }
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    { "properties": { "retry_policy": { "properties": { "max_backoff_seconds": { "minimum": 0 } } } } }
  ]
}

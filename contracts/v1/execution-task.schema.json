{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/execution-task.schema.json",
  "title": "ATG durable execution task state",
  "description": "Operational task state only. A completed task does not imply that its tests passed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "task_id", "run_id", "pair_id", "subject_role", "specification", "status", "revision", "attempt_ids", "created_at", "updated_at"],
  "properties": {
    "contract": { "const": "atg.execution_task" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "task_id": { "$ref": "common.schema.json#/$defs/id" },
    "run_id": { "$ref": "common.schema.json#/$defs/id" },
    "pair_id": { "$ref": "common.schema.json#/$defs/id" },
    "subject_role": { "enum": ["base", "candidate"] },
    "specification": { "$ref": "common.schema.json#/$defs/artifact" },
    "status": { "enum": ["queued", "eligible", "dispatching", "submitted", "running", "collecting", "completed", "failed", "blocked", "not_reached", "cancel_requested", "cancelled", "outcome_unknown", "superseded"] },
    "revision": { "type": "integer", "minimum": 1 },
    "attempt_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "active_attempt_id": { "$ref": "common.schema.json#/$defs/id" },
    "execution_result": { "$ref": "common.schema.json#/$defs/artifact" },
    "terminal_reason": { "type": "string", "minLength": 1 },
    "cancel_requested_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
